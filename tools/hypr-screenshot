        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def paint_capture(self, cr, width, height):
        # Cairo image pixels are not GTK logical coordinates. Fit to the actual
        # allocation, not the integer GTK scale factor (which rounds 1.25 to 2).
        cr.save()
        cr.scale(width / self.screen_w, height / self.screen_h)
        cr.set_source_surface(self.full_surface, 0, 0)
        cr.paint()
        cr.restore()

    def on_draw(self, area, cr, width, height):
        if width <= 0 or height <= 0:
            return
        # 1. Base full screen capture, fitted to the entire logical overlay.
        self.paint_capture(cr, width, height)

        # 2. Dim overlay
        cr.set_source_rgba(0, 0, 0, 0.45)
        cr.paint()

        if self.phase == "CROP":
            # 3. Top helper pill banner
            banner_w = 520
            banner_h = 42
            banner_x = (width - banner_w) / 2
            banner_y = 35

            # Rounded pill background
            self.draw_rounded_rect(cr, banner_x, banner_y, banner_w, banner_h, 21)
            cr.set_source_rgba(0.08, 0.09, 0.13, 0.92)
            cr.fill_preserve()
            cr.set_source_rgba(0.48, 0.64, 0.97, 0.75)
            cr.set_line_width(1.5)
            cr.stroke()

            # Banner text
            cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(13.5)
            cr.set_source_rgb(0.9, 0.93, 1.0)
            text = "✂  Drag to Crop   •   [F] Fullscreen   •   [Esc] Cancel"
            ext = cr.text_extents(text)
            cr.move_to(banner_x + (banner_w - ext.width) / 2, banner_y + (banner_h + ext.height) / 2 - 2)
            cr.show_text(text)

            # 4. If dragging, highlight active crop box
            if self.dragging:
                rx = min(self.start_x, self.cur_x)
                ry = min(self.start_y, self.cur_y)
                rw = abs(self.cur_x - self.start_x)
                rh = abs(self.cur_y - self.start_y)

                if rw > 0 and rh > 0:
                    # Clip and paint clear un-tinted screen inside selection
                    cr.save()
                    cr.rectangle(rx, ry, rw, rh)
                    cr.clip()
                    self.paint_capture(cr, width, height)
                    cr.restore()

                    # Selection border
                    cr.set_source_rgb(0.48, 0.64, 0.97)  # #7aa2f7
                    cr.set_line_width(2.0)
                    cr.rectangle(rx, ry, rw, rh)
                    cr.stroke()

                    # Dimension badge
                    _, _, pixel_w, pixel_h = logical_to_image_rect(
                        rx, ry, rw, rh, self.screen_w, self.screen_h, width, height
                    )
                    dim_text = f"{pixel_w} × {pixel_h}"
                    cr.set_font_size(12)
                    dim_ext = cr.text_extents(dim_text)
                    badge_w = dim_ext.width + 16
                    badge_h = 22
                    badge_x = rx + 8
                    badge_y = ry - 28 if ry > 35 else ry + rh + 8
                    self.draw_rounded_rect(cr, badge_x, badge_y, badge_w, badge_h, 6)
                    cr.set_source_rgba(0.08, 0.09, 0.13, 0.9)
                    cr.fill()
                    cr.set_source_rgb(0.8, 0.9, 1.0)
                    cr.move_to(badge_x + 8, badge_y + 15)
                    cr.show_text(dim_text)

        elif self.phase == "DECIDE":
            # Highlight selected cropped area in the background
            if self.crop_w > 0 and self.crop_h > 0:
                # Stored crop bounds are original pixels; the overlay is logical.
                rx = self.crop_x * width / self.screen_w
                ry = self.crop_y * height / self.screen_h
                rw = self.crop_w * width / self.screen_w
                rh = self.crop_h * height / self.screen_h
                cr.save()
                cr.rectangle(rx, ry, rw, rh)
                cr.clip()
                self.paint_capture(cr, width, height)
                cr.restore()

                cr.set_source_rgb(0.48, 0.64, 0.97)
                cr.set_line_width(2.0)
                cr.rectangle(rx, ry, rw, rh)
                cr.stroke()

    def draw_rounded_rect(self, cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -1.57079632679, 0)
        cr.arc(x + w - r, y + h - r, r, 0, 1.57079632679)
        cr.arc(x + r, y + h - r, r, 1.57079632679, 3.14159265359)
        cr.arc(x + r, y + r, r, 3.14159265359, 4.71238898038)
        cr.close_path()

    def on_drag_begin(self, gesture, x, y):
        if self.phase != "CROP":
            return
        self.dragging = True
        self.start_x = x
        self.start_y = y
        self.cur_x = x
        self.cur_y = y
        self.drawing_area.queue_draw()

    def on_drag_update(self, gesture, offset_x, offset_y):
        if self.phase != "CROP" or not self.dragging:
            return
        self.cur_x = self.start_x + offset_x
        self.cur_y = self.start_y + offset_y
        self.drawing_area.queue_draw()

    def on_drag_end(self, gesture, offset_x, offset_y):
        if self.phase != "CROP" or not self.dragging:
            return
        self.dragging = False
        self.cur_x = self.start_x + offset_x
        self.cur_y = self.start_y + offset_y

        rx = min(self.start_x, self.cur_x)
        ry = min(self.start_y, self.cur_y)
        rw = abs(self.cur_x - self.start_x)
        rh = abs(self.cur_y - self.start_y)

        # Ignore tiny accidental clicks (< 10px)
        if rw >= 10 and rh >= 10:
            bounds = logical_to_image_rect(
                rx, ry, rw, rh, self.screen_w, self.screen_h,
                self.drawing_area.get_width(), self.drawing_area.get_height()
            )
            if bounds[2] > 0 and bounds[3] > 0:
                self.finalize_crop(*bounds)
            else:
                self.drawing_area.queue_draw()
        else:
            self.drawing_area.queue_draw()

    def select_fullscreen(self):
        self.finalize_crop(0, 0, self.screen_w, self.screen_h)

    def finalize_crop(self, x, y, w, h):
        self.crop_x = x
        self.crop_y = y
        self.crop_w = w
        self.crop_h = h
        self.phase = "DECIDE"

        # Create cropped image file
        cropped_surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
        cr = cairo.Context(cropped_surf)
        cr.set_source_surface(self.full_surface, -x, -y)
        cr.paint()
        cropped_surf.write_to_png(self.cropped_png)

        # Restore default cursor
        self.win.set_cursor(None)
        self.drawing_area.queue_draw()

        # Show Decision Card UI
        self.show_decision_card()

    def show_decision_card(self):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.add_css_class("decision-card")
        card.set_halign(Gtk.Align.CENTER)
        card.set_valign(Gtk.Align.CENTER)

        # Title
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label="📸 Screenshot Captured")
        title.add_css_class("decision-title")
        title.set_halign(Gtk.Align.START)
        title_box.append(title)

        sub = Gtk.Label(label=f"Area: {self.crop_w} × {self.crop_h} px")
        sub.add_css_class("decision-sub")
        sub.set_halign(Gtk.Align.START)
        title_box.append(sub)
        card.append(title_box)

        # Image preview
        preview_container = Gtk.Box()
        preview_container.add_css_class("preview-box")
        preview_container.set_halign(Gtk.Align.CENTER)

        picture = Gtk.Picture.new_for_filename(self.cropped_png)
        picture.set_can_shrink(True)
        picture.set_content_fit(Gtk.ContentFit.CONTAIN)

        # Limit preview dimensions
        max_prev_w = 440
        max_prev_h = 240
        aspect = self.crop_w / max(self.crop_h, 1)
        if aspect >= (max_prev_w / max_prev_h):
            prev_w = min(self.crop_w, max_prev_w)
            prev_h = int(prev_w / aspect)
        else:
            prev_h = min(self.crop_h, max_prev_h)
            prev_w = int(prev_h * aspect)

        picture.set_size_request(max(prev_w, 160), max(prev_h, 90))
        preview_container.append(picture)
        card.append(preview_container)

        # Action Buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_halign(Gtk.Align.CENTER)

        btn_copy = Gtk.Button(label="📋  [C] Copy")
        btn_copy.add_css_class("btn-copy")
        btn_copy.connect("clicked", lambda _: self.action_copy())
        btn_box.append(btn_copy)

        btn_save = Gtk.Button(label="💾  [Enter] Save")
        btn_save.add_css_class("btn-save")
        btn_save.connect("clicked", lambda _: self.action_save())
        btn_box.append(btn_save)

        btn_cancel = Gtk.Button(label="✕  [Esc] Cancel")
        btn_cancel.add_css_class("btn-cancel")
        btn_cancel.connect("clicked", lambda _: self.action_cancel())
        btn_box.append(btn_cancel)

        card.append(btn_box)
        self.overlay.add_overlay(card)

    def on_key_pressed(self, controller, keyval, keycode, state):
        if self.phase == "CROP":
            # 'f' or 'F' captures full screen
            if keyval in (Gdk.KEY_f, Gdk.KEY_F):
                self.select_fullscreen()
                return True
            elif keyval == Gdk.KEY_Escape:
                self.action_cancel()
                return True

        elif self.phase == "DECIDE":
            # 'c' or 'C' copies to clipboard
            if keyval in (Gdk.KEY_c, Gdk.KEY_C):
                self.action_copy()
                return True
            # 'Enter' / 'Return' / NumPad Enter saves to file
            elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.action_save()
                return True
            elif keyval == Gdk.KEY_Escape:
                self.action_cancel()
                return True

        return False

    def action_copy(self):
        try:
            with open(self.cropped_png, "rb") as f:
                subprocess.run(["wl-copy", "--type", "image/png"], stdin=f, check=True)
            self.notify("Screenshot Copied", f"Copied {self.crop_w}×{self.crop_h} screenshot to clipboard.")
        except Exception as e:
            self.notify("Copy Failed", str(e))
        self.cleanup_and_quit()

    def action_save(self):
        try:
            save_dir = os.path.expanduser("~/Pictures/Screenshots")
            os.makedirs(save_dir, exist_ok=True)
            filename = f"Screenshot_{datetime.now().strftime('%Y-%m-%d_%H-%M-%S')}.png"
            dest = os.path.join(save_dir, filename)
            shutil.copy(self.cropped_png, dest)

            # Also copy to clipboard for convenience
            with open(dest, "rb") as f:
                subprocess.run(["wl-copy", "--type", "image/png"], stdin=f, check=True)

            self.notify("Screenshot Saved", f"Saved to Pictures/Screenshots/{filename}\nand copied to clipboard.")
        except Exception as e:
            self.notify("Save Failed", str(e))
        self.cleanup_and_quit()

    def action_cancel(self):
        self.cleanup_and_quit()

    def notify(self, title, msg):
        try:
            subprocess.run([
                "notify-send",
                "-a", "Screenshot",
                "-i", self.cropped_png if os.path.exists(self.cropped_png) else "camera-photo",
                title, msg
            ], check=False)
        except Exception:
            pass

    def cleanup(self):
        if hasattr(self, "tmp_dir") and os.path.exists(self.tmp_dir):
            shutil.rmtree(self.tmp_dir, ignore_errors=True)

    def cleanup_and_quit(self):
        self.cleanup()
        if hasattr(self, "win"):
            self.win.close()
        self.app.quit()


def main():
    app = Gtk.Application(application_id="org.cachyos.hyprsnip")
    app.connect("activate", lambda a: ScreenshotApp(a))
    app.run([])

if __name__ == "__main__":
    main()
