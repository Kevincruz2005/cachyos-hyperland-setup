#!/usr/bin/env python3
"""
Interactive Screenshot Tool for Hyprland
- Crop mode: Click & drag to select region, or press 'F' for Fullscreen, or 'Esc' to cancel.
- Decision mode: Press 'C' to copy to clipboard, 'Enter' to save to ~/Pictures/Screenshots, or 'Esc' to discard.
"""

import os
import sys

# Ensure GTK4 Layer Shell library is preloaded before libwayland
if "libgtk4-layer-shell.so" not in os.environ.get("LD_PRELOAD", ""):
    layer_lib = "/usr/lib/libgtk4-layer-shell.so"
    if os.path.exists(layer_lib):
        os.environ["LD_PRELOAD"] = f"{layer_lib} " + os.environ.get("LD_PRELOAD", "")
        os.execv(sys.executable, [sys.executable] + sys.argv)

import shutil
import json
import tempfile
import subprocess
from math import floor, ceil
from datetime import datetime

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, Gtk4LayerShell, GdkPixbuf, GLib
import cairo

def logical_to_image_rect(x, y, w, h, image_w, image_h, view_w, view_h):
    """Convert GTK logical selection edges to bounded original-image pixels."""
    sx = image_w / max(view_w, 1)
    sy = image_h / max(view_h, 1)
    left = max(0, min(image_w, floor(x * sx)))
    top = max(0, min(image_h, floor(y * sy)))
    right = max(left, min(image_w, ceil((x + w) * sx)))
    bottom = max(top, min(image_h, ceil((y + h) * sy)))
    return left, top, right - left, bottom - top

class ScreenshotApp:
    def __init__(self, gtk_app):
        self.app = gtk_app
        # Original pixel conversion was tested on a single output. Reject a
        # multi-output layout instead of silently mapping the wrong screen.
        try:
            result = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True,
                                    text=True, timeout=3, check=True)
            if len(json.loads(result.stdout)) != 1:
                raise RuntimeError("Single-output screenshot tool: use Noctalia's native screenshot UI for multiple outputs. See docs/AGENT_HANDOFF.md for adaptation.")
        except (subprocess.SubprocessError, ValueError, RuntimeError) as error:
            self.notify("Screenshot compatibility", str(error))
            sys.exit(2)
        self.tmp_dir = tempfile.mkdtemp(prefix="hypr_snip_")
        self.full_png = os.path.join(self.tmp_dir, "screen.png")
        self.cropped_png = os.path.join(self.tmp_dir, "cropped.png")

        # Capture the screen immediately to freeze state
        try:
            subprocess.run(["grim", self.full_png], check=True)
            self.full_surface = cairo.ImageSurface.create_from_png(self.full_png)
            self.screen_w = self.full_surface.get_width()
            self.screen_h = self.full_surface.get_height()
        except Exception as e:
            self.notify("Screenshot Error", f"Failed to capture screen: {e}")
            self.cleanup()
            sys.exit(1)

        # State tracking
        self.phase = "CROP"  # "CROP" or "DECIDE"
        self.dragging = False
        self.start_x = 0
        self.start_y = 0
        self.cur_x = 0
        self.cur_y = 0
        self.crop_x = 0
        self.crop_y = 0
        self.crop_w = 0
        self.crop_h = 0

        # Build UI
        self.setup_window()

    def setup_window(self):
        self.win = Gtk.ApplicationWindow(application=self.app)
        
        # Configure LayerShell
        Gtk4LayerShell.init_for_window(self.win)
        Gtk4LayerShell.set_layer(self.win, Gtk4LayerShell.Layer.OVERLAY)
        # Cover the bar too, without reserving desktop space for this overlay.
        Gtk4LayerShell.set_exclusive_zone(self.win, -1)
        Gtk4LayerShell.set_keyboard_mode(self.win, Gtk4LayerShell.KeyboardMode.EXCLUSIVE)
        for edge in [Gtk4LayerShell.Edge.TOP, Gtk4LayerShell.Edge.BOTTOM,
                     Gtk4LayerShell.Edge.LEFT, Gtk4LayerShell.Edge.RIGHT]:
            Gtk4LayerShell.set_anchor(self.win, edge, True)

        # Apply CSS styling
        self.apply_css()

        # Overlay container
        self.overlay = Gtk.Overlay()
        self.win.set_child(self.overlay)

        # Drawing Area for background & crop box
        self.drawing_area = Gtk.DrawingArea()
        self.drawing_area.set_draw_func(self.on_draw)
        self.overlay.set_child(self.drawing_area)

        # Mouse Drag gesture
        drag = Gtk.GestureDrag.new()
        drag.connect("drag-begin", self.on_drag_begin)
        drag.connect("drag-update", self.on_drag_update)
        drag.connect("drag-end", self.on_drag_end)
        self.drawing_area.add_controller(drag)

        # Keyboard controller
        key_ctrl = Gtk.EventControllerKey.new()
        key_ctrl.connect("key-pressed", self.on_key_pressed)
        self.win.add_controller(key_ctrl)

        # Set crosshair cursor
        cursor = Gdk.Cursor.new_from_name("crosshair", None)
        self.win.set_cursor(cursor)

        self.win.present()

    def apply_css(self):
        css = b"""
        .decision-card {
            background-color: rgba(22, 24, 34, 0.95);
            border: 2px solid #7aa2f7;
            border-radius: 16px;
            padding: 24px 28px;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8);
        }
        .decision-title {
            font-size: 19px;
            font-weight: 800;
            color: #c0caf5;
            margin-bottom: 2px;
        }
        .decision-sub {
            font-size: 13px;
            color: #7982a9;
            margin-bottom: 14px;
        }
        .preview-box {
            border: 1px solid rgba(122, 162, 247, 0.3);
            border-radius: 10px;
            background-color: #101417;
            padding: 4px;
            margin-bottom: 18px;
        }
        .btn-copy {
            background: linear-gradient(135deg, #3d59a1, #4872c0);
            color: #ffffff;
            font-size: 13px;
            font-weight: bold;
            border-radius: 10px;
            padding: 10px 18px;
            border: none;
        }
        .btn-copy:hover {
            background: linear-gradient(135deg, #4872c0, #5a87db);
        }
        .btn-save {
            background: linear-gradient(135deg, #7aa2f7, #89b4fa);
            color: #1a1b26;
            font-size: 13px;
            font-weight: bold;
            border-radius: 10px;
            padding: 10px 18px;
            border: none;
        }
        .btn-save:hover {
            background: linear-gradient(135deg, #89b4fa, #a6c8ff);
        }
        .btn-cancel {
            background-color: rgba(255, 255, 255, 0.08);
            color: #a9b1d6;
            font-size: 13px;
            border-radius: 10px;
